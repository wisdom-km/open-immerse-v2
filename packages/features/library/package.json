    }
  },
  "dependencies": {
    "@oi/contracts": "workspace:*",
    "@oi/kernel": "workspace:*",
    "@oi/platform-node": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
